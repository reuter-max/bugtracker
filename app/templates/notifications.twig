<div id="notifications">
	<button id="notification-button" popovertarget="notification-list">
		<i id="notification-bell" class="fa-solid fa-bell"></i>
		{% if unread_count > 0 %}
		<span id="notification-badge" class="badge">
			{{ unread_count }}
		</span>
		{% endif %}
	</button>
	<div id="notification-list" popover>
		{% for n in notifications %}
			<div class="notification notification-{{ n.type }} {{ n.read ? 'read' : 'unread' }}">
				{{ n.message }}
			</div>
		{% else %}
			<p>Keine Benachrichtigungen.</p>
		{% endfor %}
	</div>
</div>
{% set headlines = [
	'Nr.',
	'Titel',
	'Status',
	'Reporter',
	'Entwickler',
	'Erstellt',
	''
] %}

<div id="issue-table-wrapper">
	<table>
		<thead>
			<tr>
				{% for headline in headlines %}
					<th>{{ headline }}</th>
				{% endfor %}
			</tr>
		</thead>

		<tbody id="issue-table-body">
			{% for issue in issues %}
				{% include 'issues/issue_row.twig' %}
			{% else %}
				{% include 'issues/issue_row_placeholder.twig' %}
			{% endfor %}
		</tbody>
	</table>
</div>
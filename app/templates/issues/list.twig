{% extends 'main.twig' %}
{% block content %}
	<h2>{{ 'issue.title'|trans }}</h2>

	<div class="flex">
		<button type="button" hx-get="/issues/new" hx-target="#modal-content" hx-swap="innerHTML">
			<i class="fa-solid fa-plus"></i> {{ 'issue.create'|trans }}
		</button>

		<button type="button" hx-get="/issues" hx-target="#issue-table-wrapper" hx-swap="innerHTML">
			<i class="fa-solid fa-arrows-rotate"></i> {{ 'issue.refresh'|trans }}
		</button>
	</div>
	
	<div id="issue-table-wrapper">
		{% include 'issues/issue_table.twig' %}
	</div>
{% endblock %}


<footer class="flex items-center justify-between">
	<span>
		<span>
			<i class="fa-solid fa-tag"></i> Bugtracker {{ version.current }}
		</span>
		<span>|</span>
		<a href="https://github.com/reuter-max/bugtracker" target="_blank">
			<i class="fa-brands fa-github"></i> GitHub
		</a>
	</span>
	{% if version.update_available %}
	<span>
		{{ 'app.update_available'|trans }}
		<a href="{{ version.url }}" target="_blank">
			<i class="fa-solid fa-cloud-arrow-up"></i> {{ version.latest }}
		</a>
	</span>
	{% endif %}
	<span>
		<span>
			<i class="fa-regular fa-copyright"></i>2026 Bugtracker
		</span>
		<span>|</span>
		<a title="CC BY-NC-SA 4.0" href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank">
			<i class="fa-brands fa-creative-commons"></i><i class="fa-brands fa-creative-commons-by"></i><i class="fa-brands fa-creative-commons-nc-eu"></i><i class="fa-brands fa-creative-commons-sa"></i>
		</a>
	</span>
</footer>
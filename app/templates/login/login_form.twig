<section id="login-form-wrapper" class="flex-center flex-grow">
	<form hx-post="/login" hx-target="#login-form-wrapper" hx-swap="outerHTML">
		<h2>{{ 'auth.login.title'|trans }}</h2>

		<label>
			<span>{{ 'auth.login.email'|trans }}</span>
			<input type="email" name="email" required>
		</label>

		<label>
			<span>{{ 'auth.login.password'|trans }}</span>
			<input type="password" name="password" required>
		</label>

		<button type="submit">
			{{ 'auth.login.submit'|trans }}
		</button>

		{% if error %}
			<p class="infobox warning">
				<i class="fa-solid fa-triangle-exclamation"></i> {{ error }}
			</p>
		{% endif %}
	</form>
</section>
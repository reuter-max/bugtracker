<header class="flex justify-between">
	<h1>Bugtracker</h1>
	{% if user %}
		<div class="flex items-center gap-sm">
			<span>
				<b>
					{{ user.displayName }}
				</b>
			</span>
			<span>|</span>
			<div hx-get="/notifications" hx-trigger="load, every 15s" hx-swap="innerHTML">
				{% include 'notifications.twig' with {'notifications': [], 'unread_count': 0} %}
			</div>
			<span>|</span>
			<button hx-post="/logout" hx-swap="none">
				{{ 'auth.logout'|trans }}
				<i class="fa-solid fa-arrow-right-from-bracket"></i> 
			</button>
		</div>
	{% endif %}
</header>